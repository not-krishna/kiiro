# ==========================================
# Sanity CMS Configuration (Public)
# ==========================================
NEXT_PUBLIC_SANITY_PROJECT_ID=s47moswb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# ==========================================
# Sanity API Write Token (Server-Side ONLY)
# ==========================================
# Required to push mutations and upload images directly to Sanity cloud.
# Generate in Sanity Management -> API -> Tokens -> Editor / Contributor.
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# ==========================================
# Admin Panel Security & Authentication
# ==========================================
# Secret used for signing HMAC-SHA256 session tokens.
# Generate a random 64-character string in production.
KIIRO_AUTH_SECRET=your_random_32_or_64_character_secret_key_here

# Initial Admin Bootstrap (Optional overrides)
# If not provided, defaults to kiiroadmin / k1rr0@dmin
# ADMIN_USERNAME=kiiroadmin
# ADMIN_PASSWORD=your_secure_password_here
